# Public base URL used to construct exact callback and attempt URLs.
APP_BASE_URL=http://127.0.0.1:3000
APP_ENV=development

# `mock` is permitted only outside production. Production requires `instagram`.
ONBOARDING_PROVIDER=mock

# Server-only session/checkpoint keys. Use independently generated values.
BROWSER_SECRET_PEPPER=
CHECKPOINT_ENCRYPTION_KEYS=
INTERNAL_JOB_SECRET=

# Instagram Business Login. Verify values in the target Meta dashboard before use.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
INSTAGRAM_GRAPH_API_VERSION=v22.0
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights

# Supabase server access. Prefer a current sb_secret_* key when available.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_EXPECTED_PROJECT_REF=

# SMTP is disabled by default and must never be enabled in local automated tests.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_TO=dkssud374@celeblife.co.kr

# Optional bounded worker settings.
JOB_BATCH_SIZE=25
PROVIDER_TIMEOUT_MS=10000
SMTP_TIMEOUT_MS=10000

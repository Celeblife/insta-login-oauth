# REFERENCE ONLY. Copy to the new app, not the live project's settings.
# Keep secrets out of Git, chat, client bundles, logs, and screenshots.
# The designated, non-secret internal mailbox appears below by owner instruction; no credentials are included.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
ONBOARDING_MODE=mock
V2_ONBOARDING_ENABLED=true
DEV_UI_PREVIEW=true

# Real Meta integration requires approved app settings. None are invented here.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=
OAUTH_REDIRECT_URI=
# Current repo scopes; verify actual granted/app-approved scopes before live use.
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights

# Server-only Supabase key. Never use NEXT_PUBLIC_ for any of these secrets.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TEST_PROJECT_REF=
SUPABASE_PRODUCTION_PROJECT_REF=
# Exact real production project. Staging may also have VERCEL_ENV=production.
V2_PRODUCTION_VERCEL_PROJECT_ID=

# Temporary OAuth code/token checkpoint encryption, 32-byte base64 key.
# Generate/register through approved secret management; do not print the value.
ONBOARDING_ENCRYPTION_KEY_B64=
ONBOARDING_ENCRYPTION_KEY_ID=
# Existing v1 state/cookie verification settings must be mapped from real source.
# Do not rotate existing production secrets as part of this handoff.

# Product defaults (not provider guarantees)
OAUTH_STATE_TTL_SECONDS=600
ONBOARDING_DRAFT_TTL_SECONDS=1800
RECEIPT_TTL_SECONDS=86400
OAUTH_HTTP_TIMEOUT_MS=10000
ONBOARDING_OPERATION_TIMEOUT_MS=45000
ONBOARDING_LEASE_SECONDS=90

# Real, reviewed policy bundle is mandatory in live mode.
POLICY_BUNDLE_ID=
POLICY_DOCUMENTS_APPROVED=false
# Public support contact: retain the existing reviewed value.
# Do NOT automatically publish the internal recipient as the support address.
CONTACT_EMAIL=

# SMTP values must be verified in the company's NAVER WORKS settings.
# For implicit TLS use secure=true; for STARTTLS use secure=false + requireTLS=true.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
# Candidate sender/login matches owner mailbox; verify company SMTP permission.
SMTP_USER=dkssud374@celeblife.co.kr
SMTP_PASSWORD=
MAIL_FROM=dkssud374@celeblife.co.kr
# Confirmed internal recipient. No user-controlled recipient override.
NOTIFICATION_TO=dkssud374@celeblife.co.kr
# Use a separate approved test mailbox outside production.
NOTIFICATION_TEST_TO=

# All background writes disabled by default outside an explicitly approved deployment.
TOKEN_REFRESH_ENABLED=false
NOTIFICATION_RETRY_ENABLED=false
ONBOARDING_CLEANUP_ENABLED=false
CRON_SECRET=
TOKEN_REFRESH_DAYS_BEFORE_EXPIRY=7
TOKEN_REFRESH_ALERT_WEBHOOK_URL=

# Final-review additions. No credentials are supplied.
# Hash canonical start payload with a separate keyed HMAC to avoid guessable contact hashes.
ONBOARDING_FINGERPRINT_KEY_B64=
# Migration phase: keep exact plaintext read contract; not application-level encryption.
TOKEN_STORAGE_MODE=legacy_plaintext
# Proposed worker timings; require a commercial plan supporting 5-minute cron.
NOTIFICATION_RETRY_CRON="*/5 * * * *"
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=10000
NOTIFICATION_WORKER_BUDGET_MS=45000
NOTIFICATION_LEASE_SECONDS=90
NOTIFICATION_MAX_ATTEMPTS=5
# Explicit pre-production gates, not proof by themselves.
COMMERCIAL_PLAN_CONFIRMED=false
TOKEN_STORAGE_RISK_ACCEPTED=false
# Filled from approved retention policy; never infer from draft TTL.
RETENTION_POLICY_ID=

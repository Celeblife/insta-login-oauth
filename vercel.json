{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/Login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/auth/instagram/start",
      "destination": "/api/instagram_start"
    }
  ],
  "crons": [
    {
      "path": "/internal/token-refresh",
      "schedule": "23 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/__canary/login-static",
      "headers": [
        {
          "key": "x-celeblife-static-canary",
          "value": "login-static"
        }
      ]
    }
  ]
}
